{
    "description": "Physical memory in use, bar colored by level",
    "exec": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${dir}\\memory.ps1\" -Styled",
    "interval": 5,
    "output": "html",
    "css": { "font-family": "Consolas", "text-align": "left" },
    "classes": {
        "green": { "color": "#7fdbb0" },
        "yellow": { "color": "#f5c542" },
        "orange": { "color": "#ff9f43" },
        "red": { "color": "#ff5555" }
    }
}
